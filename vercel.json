{
  "version": 2,
  "redirects": [
    {
      "source": "/((?!api/).*)",
      "has": [
        {
          "type": "host",
          "value": "spinwheel3d.vercel.app"
        }
      ],
      "destination": "https://www.spinandwin.world/$1",
      "permanent": true
    }
  ],
  "routes": [
    {
      "src": "/api/state",
      "dest": "/api/state.js"
    },
    {
      "src": "/(.*)",
      "dest": "/$1"
    }
  ]
}
